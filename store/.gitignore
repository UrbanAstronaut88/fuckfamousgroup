# App-level rules: keep this file when store is published as a standalone project.
# The parent .gitignore adds repository-wide protection for GitHub.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
*.sqlite*
*.db
*.db-*
*.tar.gz
*.log
.idea/
.vscode/
*credentials*.json
admin-access*.txt
local-auth*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment
.env*
!.env.example
!.env.sample
.dev.vars*
*.tsbuildinfo

# deployment and generated files
.vercel
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
/.sites-runtime/

# Cloud credentials and local deployment configuration
.aws/
**/.aws/
**/wrangler.production.json
