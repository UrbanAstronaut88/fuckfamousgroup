ADMIN_SECRET=
ADMIN_LOGIN=
ADMIN_INITIAL_CREDENTIAL=
# HTTPS always requires MFA. Set true to require it on localhost too.
ADMIN_REQUIRE_MFA=true
# Generate ADMIN_SECRET as 32 random bytes in hex; prepare-admin.mjs creates the initial password hash.
# Use different secrets for local and hosted copies. Never commit actual values.
# Ordering takes place via manager profile links in lib/links.ts.
# No Telegram bot credentials are required.
