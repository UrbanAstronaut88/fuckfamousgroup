# ШАБЛОН БЕЗ СЕКРЕТОВ. Этот файл можно хранить в GitHub.
# Приложение работает в Cloudflare Workers, а не в Python.
# Локально скопируйте этот файл в .dev.vars ТОЛЬКО при новой установке.
# Не заменяйте существующий .dev.vars: потеря ADMIN_SECRET нарушит вход и TOTP.
# На хостинге задавайте значения как Secrets, а не NEXT_PUBLIC_* / VITE_*.

# Постоянный серверный секрет: 32 случайных байта в hex (64 символа).
# У каждой среды свой секрет. Для действующей базы сохраняйте прежний.
ADMIN_SECRET=

# Единственный логин администратора. Не публикуется в клиентском JavaScript.
ADMIN_LOGIN=

# Только для НОВОЙ базы: JSON с солью, хешем пароля и iterations=600000.
# Создаётся командой node scripts/prepare-admin.mjs (--local для локальной среды).
# Не вводите сюда настоящий пароль. Удалите секрет после первого успешного входа.
# При существующем администраторе оставьте пустым; пароль хранится в базе.
ADMIN_INITIAL_CREDENTIAL=

# Требовать двухфакторный вход и на localhost.
# На опубликованном HTTPS-сайте второй фактор обязателен независимо от флага.
ADMIN_REQUIRE_MFA=true

# DB и MEDIA — привязки D1/R2 в Wrangler, а не строки подключения в .env.
# Токены GitHub/Cloudflare и пароль администратора здесь не нужны.
# Для заказов используются ссылки менеджера; Telegram-бот не нужен.
